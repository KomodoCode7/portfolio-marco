---
import Nextjs from "./icons/Nextjs.astro"
import Tailwind from "./icons/Tailwind.astro"
import Javascript from "./icons/Javascript.astro"
import Typescript from "./icons/Typescript.astro"
import Openai from "./icons/Openai.astro"
import Prisma from "./icons/Prisma.astro"
const TAGS = {
    NEXT: {
        name: "Next.Js",
        color: "bg-black text-white",
        icon: Nextjs 
    },
    TAILWIND: {
        name: "TailwindCSS",
        color: "bg-white text-black",
        icon: Tailwind
    },
    JAVASCRIPT: {
        name: "JavaScript",
        color: "bg-yellow-400 text-black",
        icon: Javascript
    },
    TYPESCRIPT: {
        name: "TypeScript",
        color: "bg-black text-white",
        icon: Typescript
    },
    OPENAI: {
        name: "OpenAi API",
        color: "bg-white text-black",
        icon: Openai
    },
    PRISMA: {
        name: "Prisma",
        color: "bg-black text-white",
        icon: Prisma
    }
}
const PROJECTS = [
    {
        title: "Millions - E-commerce de joyería personalizada",
        description: `Storefront full-stack para vender joyas personalizadas con fotografías. Incluye catálogo, simulador visual, carrito para clientes e invitados, autenticación con Google, checkout con Webpay Plus, gestión de pedidos y stock, correos transaccionales, almacenamiento privado de imágenes y un panel administrativo para la operación y revisión de diseños.`,
        images: [
            {
                src: "/millions-home.webp",
                alt: "Página principal de Millions con un medallón personalizado"
            },
            {
                src: "/millions-collection.webp",
                alt: "Catálogo de modelos de joyas personalizadas de Millions"
            },
            {
                src: "/millions-customizer.webp",
                alt: "Personalizador de fotografías para medallones de Millions"
            }
        ],
        tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.TYPESCRIPT, TAGS.PRISMA],
        featured: true
    },
    {
        title: "Plataforma de Gestión Marítimo-Logística",
        description: `Plataforma integral para gestión de cotizaciones, registro operativo, cierres mensuales e integración con Softland. 
        Sistema en construcción con arquitectura cloud escalable: NestJS, Next.js, PostgreSQL/Neon, Cloud Run, Cloudflare R2, MS Entra ID.
        Enfocado en optimización de procesos marítimos y reducción de trabajo manual.`,
        image: "/plataforma-maritimo-logistica.webp",
        tags: [TAGS.NEXT, TAGS.TYPESCRIPT, TAGS.PRISMA],
        featured: true
    },
    {
        title: "Sistema de Gestión de Información Académica - Proyecto de Título",
        description: `Plataforma web full-stack desarrollada como Proyecto de Título para la Universidad de Los Lagos. 
        Sistema que permite a directores de carrera identificar proactivamente estudiantes en riesgo académico mediante 
        dashboards interactivos y alertas automáticas. Transforma datos crudos en información accionable, facilitando 
        decisiones estratégicas para mejorar la retención y el éxito estudiantil.`,
        image: "/proyecto-titulo.webp",
        tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.TYPESCRIPT, TAGS.PRISMA],
        featured: true
    },
    {
        title: "Dr. Computín - Asistente Virtual para Problemas de Hardware",
        description: `Desarrollado con Next.js, TailwindCSS y la API de OpenAI,
     Dr. Computín es una aplicación web diseñada para ayudar a usuarios con problemas de hardware 
     en sus computadoras. Utilizando la inteligencia artificial de OpenAI, Dr. Computín 
     ofrece asistencia y diagnósticos preliminares. Además, permite al usuario generar un resumen de su problema,
     que puede compartir con un técnico de confianza para facilitar la reparación.`,
        image: "/DrComputin.webp",
        tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.OPENAI, TAGS.TYPESCRIPT, TAGS.PRISMA],
        featured: false
    },
    {
        title: "Landing Page para Fanbooks, distribuidora de libros para colegios",
        description: `Desarrollada con Next.js y TailwindCSS, esta landing page es una plataforma de presentación para Fanbooks,
         una distribuidora de libros para colegios. La página está diseñada para ser atractiva y funcional, 
         con el objetivo de presentar la empresa y sus servicios de manera clara y efectiva. Cuenta con secciones que detallan su identidad empresarial,
         las distintas editoriales asociadas y una sección de contacto para facilitar la comunicación con los interesados.`,
        link: "https://fanbooks.cl",
        image: "/fanbooks.png",
        tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.TYPESCRIPT],
        featured: false
    }
]
---

<section
    class="project-carousel"
    data-project-carousel
    aria-label="Proyectos seleccionados"
    aria-roledescription="carrusel"
>
    <div class="mb-5 flex items-center justify-between gap-4">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-white/50" aria-live="polite">
            Proyecto <span class="text-yellow-400" data-carousel-current>01</span>
            <span aria-hidden="true">/</span>
            <span>{String(PROJECTS.length).padStart(2, '0')}</span>
        </p>

        <div class="flex gap-2">
            <button
                type="button"
                class="inline-flex size-11 items-center justify-center rounded-full border border-white/20 bg-white/5 text-white transition hover:border-purple-400 hover:bg-purple-500/15 hover:text-purple-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-400 motion-reduce:transition-none"
                data-carousel-prev
                aria-label="Ver proyecto anterior"
            >
                <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" aria-hidden="true">
                    <path d="m15 18-6-6 6-6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
            </button>
            <button
                type="button"
                class="inline-flex size-11 items-center justify-center rounded-full border border-white/20 bg-white/5 text-white transition hover:border-purple-400 hover:bg-purple-500/15 hover:text-purple-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-400 motion-reduce:transition-none"
                data-carousel-next
                aria-label="Ver proyecto siguiente"
            >
                <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" aria-hidden="true">
                    <path d="m9 18 6-6-6-6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
            </button>
        </div>
    </div>

    <div
        class="project-carousel__viewport overflow-x-auto overscroll-x-contain rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-400 focus-visible:ring-offset-4 focus-visible:ring-offset-[#00010D]"
        data-carousel-viewport
        tabindex="0"
        aria-label="Usa las flechas izquierda y derecha para cambiar de proyecto"
    >
        <ul class="m-0 flex list-none snap-x snap-mandatory p-0" data-carousel-track>
        {
            PROJECTS.map(({ title, description, link, image, images, tags, featured }, projectIndex) => (
            <li
                class="min-w-full snap-start"
                data-carousel-slide
                aria-label={`${projectIndex + 1} de ${PROJECTS.length}: ${title}`}
            >
            <article class={`h-full rounded-2xl border p-4 md:p-7 ${featured ? "border-yellow-400/30 bg-yellow-400/5" : "border-white/10 bg-white/[0.03]"}`}>
                {featured && (
                    <div class="mb-4">
                        <span class="text-xs bg-yellow-400/20 text-yellow-400 px-3 py-1 rounded-full font-medium">
                            ⭐ Proyecto Destacado
                        </span>
                    </div>
                )}
                
                <!-- Layout Grid para desktop, stack para mobile -->
                <div class={`grid grid-cols-1 gap-6 items-start ${images ? "lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]" : "lg:grid-cols-2"}`}>
                    <!-- Contenido del proyecto -->
                    <div class="order-2 lg:order-1">
                        <h3 class="text-2xl font-semibold text-yellow-400/80 mb-3">{title}</h3>
                        <p class="text-base mb-4 text-pretty text-white/90 leading-relaxed">{description}</p>
                        
                        {link && (
                            <a href={link} class="inline-flex items-center gap-2 text-purple-500 hover:text-purple-400 transition-colors mb-4 text-sm font-medium">
                                {link.startsWith('/') ? 'Ver case study completo →' : 'Visitar sitio →'}
                            </a>    
                        )}
                        
                        <div class="flex gap-x-2 mt-4">
                            <ul class="flex gap-x-2 flex-row flex-wrap gap-y-2">
                                {tags.map(tag => (
                                <li>
                                    <span 
                                    class={`flex align-center items-center gap-x-2 rounded-full text-xs font-medium ${tag.color} py-1 px-2 border-2 border-white/50 hover:scale-110 transition-transform`}>
                                        <tag.icon class="size-5"/>
                                        {tag.name}
                                    </span>
                                </li>
                            ))}
                            </ul>
                        </div>
                    </div>
                    
                    <!-- Imagen del proyecto -->
                    {images ? (
                        <div class="order-1 lg:order-2 grid grid-cols-2 gap-2" aria-label={`Galería de ${title}`}>
                            {images.map((projectImage, index) => (
                                <figure class={index === 0 ? "col-span-2" : "col-span-1"}>
                                    <img
                                        src={projectImage.src}
                                        alt={projectImage.alt}
                                        class={`rounded-lg border border-white/10 shadow-2xl shadow-white/10 w-full object-cover transition-transform duration-300 hover:scale-[1.02] ${index === 0 ? "aspect-[2.1/1]" : "aspect-[2.05/1]"}`}
                                        width="1600"
                                        height="762"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </figure>
                            ))}
                        </div>
                    ) : image && (
                        <div class="order-1 lg:order-2">
                            <img 
                                src={image} 
                                alt={title} 
                                class="rounded-lg shadow-2xl shadow-white/10 hover:scale-105 transition-transform w-full h-auto object-cover max-h-[400px] lg:max-h-[350px]"
                                width="600"
                                height="338"
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                    )}
                </div>
            </article>
            </li>
            ))
        }
        </ul>
    </div>

    <div class="mt-5 flex items-center justify-center gap-2" aria-label="Seleccionar proyecto">
        {PROJECTS.map((project, index) => (
            <button
                type="button"
                class="h-2.5 w-2.5 rounded-full bg-white/25 transition-[width,background-color] duration-300 hover:bg-white/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-400 focus-visible:ring-offset-2 focus-visible:ring-offset-[#00010D] motion-reduce:transition-none"
                data-carousel-dot
                data-index={index}
                aria-label={`Ir al proyecto ${index + 1}: ${project.title}`}
            ></button>
        ))}
    </div>
</section>

<script>
    const carousels = document.querySelectorAll<HTMLElement>('[data-project-carousel]');

    carousels.forEach((carousel) => {
        const viewport = carousel.querySelector<HTMLElement>('[data-carousel-viewport]');
        const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
        const previousButton = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
        const nextButton = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
        const currentLabel = carousel.querySelector<HTMLElement>('[data-carousel-current]');
        const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));

        if (!viewport || !previousButton || !nextButton || !currentLabel || slides.length === 0) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let currentIndex = 0;
        let scrollFrame = 0;

        const updateState = (index: number) => {
            currentIndex = index;
            currentLabel.textContent = String(index + 1).padStart(2, '0');

            slides.forEach((slide, slideIndex) => {
                slide.inert = slideIndex !== index;
            });

            dots.forEach((dot, dotIndex) => {
                const isCurrent = dotIndex === index;
                dot.setAttribute('aria-current', isCurrent ? 'true' : 'false');
                dot.classList.toggle('w-8', isCurrent);
                dot.classList.toggle('bg-purple-400', isCurrent);
                dot.classList.toggle('bg-white/25', !isCurrent);
            });
        };

        const goTo = (index: number) => {
            const normalizedIndex = (index + slides.length) % slides.length;
            updateState(normalizedIndex);
            viewport.scrollTo({
                left: slides[normalizedIndex].offsetLeft - slides[0].offsetLeft,
                behavior: prefersReducedMotion.matches ? 'auto' : 'smooth'
            });
        };

        const handleScroll = () => {
            cancelAnimationFrame(scrollFrame);
            scrollFrame = requestAnimationFrame(() => {
                const closestIndex = slides.reduce((closest, slide, index) => {
                    const firstSlideOffset = slides[0].offsetLeft;
                    const currentDistance = Math.abs((slide.offsetLeft - firstSlideOffset) - viewport.scrollLeft);
                    const closestDistance = Math.abs((slides[closest].offsetLeft - firstSlideOffset) - viewport.scrollLeft);
                    return currentDistance < closestDistance ? index : closest;
                }, 0);

                if (closestIndex !== currentIndex) updateState(closestIndex);
            });
        };

        const handlePrevious = () => goTo(currentIndex - 1);
        const handleNext = () => goTo(currentIndex + 1);
        const handleKeydown = (event: KeyboardEvent) => {
            if (event.key === 'ArrowLeft') {
                event.preventDefault();
                handlePrevious();
            }

            if (event.key === 'ArrowRight') {
                event.preventDefault();
                handleNext();
            }
        };

        previousButton.addEventListener('click', handlePrevious);
        nextButton.addEventListener('click', handleNext);
        viewport.addEventListener('scroll', handleScroll, { passive: true });
        viewport.addEventListener('keydown', handleKeydown);
        dots.forEach((dot, index) => dot.addEventListener('click', () => goTo(index)));

        const resizeObserver = new ResizeObserver(() => {
            viewport.scrollTo({
                left: slides[currentIndex].offsetLeft - slides[0].offsetLeft,
                behavior: 'auto'
            });
        });
        resizeObserver.observe(viewport);

        updateState(0);

        const cleanup = () => {
            cancelAnimationFrame(scrollFrame);
            resizeObserver.disconnect();
            previousButton.removeEventListener('click', handlePrevious);
            nextButton.removeEventListener('click', handleNext);
            viewport.removeEventListener('scroll', handleScroll);
            viewport.removeEventListener('keydown', handleKeydown);
        };

        window.addEventListener('pagehide', cleanup, { once: true });
        document.addEventListener('astro:before-swap', cleanup, { once: true });
    });
</script>

<style>
    .project-carousel__viewport {
        scrollbar-width: none;
    }

    .project-carousel__viewport::-webkit-scrollbar {
        display: none;
    }
</style>
