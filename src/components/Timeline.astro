---
const TIMELINE_EVENTS = [
    {
        year: "Jul 2025",
        title: "Ingeniero de Software - ST Consultores",
        description: "Desarrollo y arquitectura de soluciones empresariales escalables. Diseño de sistemas de gestión, optimización de procesos y consultoría técnica para clientes corporativos.",
        highlight: true,
        current: true
    },
    {
        year: "Ago 2025",
        title: "Titulado como Ingeniero Civil en Informática",
        description: "Universidad de Los Lagos. Proyecto de Título: Sistema de Gestión de Información Académica con dashboards interactivos y alertas automáticas para identificar estudiantes en riesgo académico.",
        highlight: true,
        current: false
    },
    {
        year: "Ene - Jun 2025",
        title: "Desarrollador Web - Sotex S.P.A.",
        description: "Desarrollo de sistemas web para optimización de procesos empresariales. Enfoque en arquitectura de datos, diseño de bases de datos con Prisma ORM, y desarrollo de plataformas eficientes.",
        highlight: false,
        current: false
    },
    {
        year: "Sep - Dic 2024",
        title: "Desarrollador Full Stack - Cafetería Panichini",
        description: "Desarrollo e implementación de sistema de gestión documental en la nube utilizando OneDrive y Microsoft Graph API para optimización de procesos administrativos.",
        highlight: false,
        current: false
    },
    {
        year: "Ago 2023 - Jun 2024",
        title: "Encargado de Aseguramiento de Calidad (QA) - Sotex S.P.A.",
        description: "Responsable de calidad del software. Diseño de estrategias de testing funcional, pruebas de caja negra, validación de requerimientos y coordinación con equipo de desarrollo.",
        highlight: false,
        current: false
    },
    {
        year: "Ener 2022 - Jul 2023",
        title: "Analista de Datos - ASECONEST LIMITADA",
        description: "Inicio en la industria del software. Análisis de datos, soporte técnico a usuarios, generación de reportes y visualizaciones. Primera experiencia profesional mientras cursaba 3er año de Ingeniería Civil Informática.",
        highlight: false,
        current: false
    },
]
---

<div class="relative timeline-container">
    <!-- Línea vertical animada -->
    <svg class="absolute left-8 top-0 h-full w-0.5 timeline-line-svg" aria-hidden="true">
        <defs>
            <linearGradient id="timeline-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" style="stop-color:#22d3ee;stop-opacity:1" />
                <stop offset="50%" style="stop-color:#fbbf24;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#ef4444;stop-opacity:1" />
            </linearGradient>
        </defs>
        <line 
            class="timeline-line" 
            x1="1" 
            y1="0" 
            x2="1" 
            y2="100%" 
            stroke="url(#timeline-gradient)" 
            stroke-width="2"
            stroke-dasharray="1000"
            stroke-dashoffset="1000"
        />
    </svg>
    
    <div class="space-y-8">
        {TIMELINE_EVENTS.map((event, index) => (
            <div class="relative pt-2 md:pl-20 group timeline-item" data-index={index}>
                <!-- Punto en la línea -->
                <div class={`timeline-dot absolute -top-5 left-2 md:left-6 w-5 h-5 rounded-full border-4 ${
                    event.highlight 
                        ? 'bg-yellow-400 border-yellow-400 shadow-lg shadow-yellow-400/50' 
                        : 'bg-purple-500 border-purple-500'
                } z-10`}></div>
                
                <!-- Contenido del evento -->
                <div class={`timeline-card rounded-xl border p-6 transition-all duration-300 ${
                    event.highlight
                        ? 'border-yellow-400/30 bg-yellow-400/10 hover:border-yellow-400/50 hover:bg-yellow-400/20'
                        : 'border-white/10 bg-white/10 hover:border-white/20 hover:bg-white/20'
                } backdrop-blur-sm`}>
                    <div class="flex items-center gap-3 mb-3 flex-wrap">
                        <span class={`text-sm font-bold px-3 py-1 rounded-full ${
                            event.highlight
                                ? 'bg-yellow-400/20 text-yellow-400'
                                : 'bg-purple-500/20 text-purple-500'
                        }`}>
                            {event.year}
                        </span>
                        {event.current && (
                            <span class="text-xs bg-green-500/20 text-green-400 px-2 py-1 rounded-full font-medium pulse-badge">
                                Actual
                            </span>
                        )}
                        {event.highlight && !event.current && (
                            <span class="text-xs bg-red-500/20 text-red-400 px-2 py-1 rounded-full">
                                Destacado
                            </span>
                        )}
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 leading-tight">
                        {event.title}
                    </h3>
                    <p class="text-sm text-white/70 leading-relaxed">
                        {event.description}
                    </p>
                </div>
            </div>
        ))}
    </div>
</div>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);

// Storage for cleanup
const scrollTriggers: ScrollTrigger[] = [];
const eventHandlers: Array<{ el: Element; event: string; fn: EventListener }> = [];
const animations: gsap.core.Animation[] = [];

// Check reduced motion preference
const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

// Initialize animations (DOM is already ready in Astro)
(() => {
    const timelineContainer = document.querySelector('.timeline-container');
    const timelineItems = document.querySelectorAll('.timeline-item');
    const pulseBadge = document.querySelector('.pulse-badge');

    if (!timelineContainer || !timelineItems.length) return;

    // Set will-change for performance
    gsap.set(['.timeline-line', '.timeline-dot', '.timeline-card'], {
        willChange: 'transform, opacity'
    });

    if (prefersReducedMotion) {
        // Set final states immediately without animation
        gsap.set('.timeline-line', { strokeDashoffset: 0 });
        gsap.set('.timeline-dot', { scale: 1, opacity: 1 });
        gsap.set('.timeline-card', { x: 0, opacity: 1 });
        
        // Remove will-change
        gsap.set(['.timeline-line', '.timeline-dot', '.timeline-card'], {
            willChange: 'auto'
        });
        return;
    }

    // Animación de la línea principal del timeline
    const lineAnimation = gsap.to('.timeline-line', {
        strokeDashoffset: 0,
        ease: 'none',
        scrollTrigger: {
            trigger: timelineContainer,
            start: 'top center',
            end: 'bottom center',
            scrub: 1,
            onLeave: () => {
                // Remove will-change when animation completes
                gsap.set('.timeline-line', { willChange: 'auto' });
            }
        }
    });
    animations.push(lineAnimation);
    
    if (lineAnimation.scrollTrigger) {
        scrollTriggers.push(lineAnimation.scrollTrigger);
    }

    // Animar cada item del timeline
    timelineItems.forEach((item) => {
        const dot = item.querySelector('.timeline-dot');
        const card = item.querySelector('.timeline-card');
        
        if (!dot || !card) return;

        // Crear timeline de GSAP para cada item con ScrollTrigger
        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: item,
                start: 'top 80%',
                end: 'top 20%',
                toggleActions: 'play none none reverse'
            },
            onComplete: () => {
                // Remove will-change after first animation
                gsap.set([dot, card], { willChange: 'auto' });
            }
        });
        animations.push(tl);

        if (tl.scrollTrigger) {
            scrollTriggers.push(tl.scrollTrigger);
        }

        // Animación del punto
        tl.to(dot, {
            scale: 1,
            opacity: 1,
            duration: 0.4,
            ease: 'back.out(1.7)',
        });

        // Animación de la card (desde la izquierda)
        tl.to(card, {
            x: 0,
            opacity: 1,
            duration: 0.2,
            ease: 'power3.out',
        }, '-=0.2'); // Overlap con la animación anterior

        // Hover effect en las cards
        const handleMouseEnter = () => {
            gsap.killTweensOf([card, dot]);
            gsap.to(card, {
                y: -5,
                duration: 0.3,
                ease: 'power2.out',
            });
            gsap.to(dot, {
                y: -5,
                scale: 1.2,
                duration: 0.3,
                ease: 'elastic.out(1, 0.3)',
            });
        };

        const handleMouseLeave = () => {
            gsap.killTweensOf([card, dot]);
            gsap.to(card, {
                y: 0,
                duration: 0.3,
                ease: 'power2.out',
            });
            gsap.to(dot, {
                y: 0,
                scale: 1,
                duration: 0.3,
                ease: 'elastic.out(1, 0.3)',
            });
        };

        item.addEventListener('mouseenter', handleMouseEnter);
        item.addEventListener('mouseleave', handleMouseLeave);
        
        eventHandlers.push(
            { el: item, event: 'mouseenter', fn: handleMouseEnter },
            { el: item, event: 'mouseleave', fn: handleMouseLeave }
        );
    });

    // Animación del badge "Actual" (usando solo GSAP, no CSS)
    if (pulseBadge) {
        const badgeAnimation = gsap.to(pulseBadge, {
            scale: 1.05,
            duration: 1,
            repeat: -1,
            yoyo: true,
            ease: 'power1.inOut',
        });
        animations.push(badgeAnimation);
    }
})();

// Cleanup on page unload/navigation
window.addEventListener('beforeunload', () => {
    // Kill all ScrollTriggers
    scrollTriggers.forEach(trigger => trigger.kill());
    
    // Remove all event listeners
    eventHandlers.forEach(({ el, event, fn }) => {
        el.removeEventListener(event, fn);
    });
    
    // Kill all animations
    animations.forEach(anim => anim.kill());
    const timelineRoot = document.querySelector('.timeline-container');
    if (timelineRoot) {
        gsap.killTweensOf(timelineRoot.querySelectorAll('*'));
    }
});

// Cleanup for Astro View Transitions (if enabled)
document.addEventListener('astro:before-swap', () => {
    scrollTriggers.forEach(trigger => trigger.kill());
    eventHandlers.forEach(({ el, event, fn }) => {
        el.removeEventListener(event, fn);
    });
    animations.forEach(anim => anim.kill());
    const timelineRoot = document.querySelector('.timeline-container');
    if (timelineRoot) {
        gsap.killTweensOf(timelineRoot.querySelectorAll('*'));
    }
});
</script>

<style>
    .timeline-container {
        position: relative;
        overflow-x: clip;
    }

    .timeline-line-svg {
        pointer-events: none;
        overflow: hidden;
    }

    /* Estado inicial oculto con CSS para evitar FOUC */
    .timeline-dot {
        opacity: 0;
        transform: scale(0);
    }

    .timeline-card {
        transform-origin: left center;
        opacity: 0;
        transform: translateX(-30px);
    }
</style>
